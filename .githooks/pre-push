#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# A push that only deletes branches delivers no source. Classification reads the
# complete pre-push input once; every other input keeps the full gate below.
if "$repo_root/scripts/pre-push-deletion-only.sh"; then
  echo "Pre-push input contains only valid branch deletions; no source is being delivered."
  exit 0
fi

"$repo_root/scripts/docpact-gate.sh" "$@"

echo "Auditing the Rust-only active tree."
"$repo_root/scripts/audit-rust-only.sh"

echo "Checking executable asset lock."
cargo run --locked -p tidas-assets --bin tidas-asset-lock -- check

echo "Running Rust formatting, lint, and test gates."
cargo fmt --all --check
cargo clippy --locked --workspace --all-targets -- -D warnings
cargo test --locked --workspace --all-targets
