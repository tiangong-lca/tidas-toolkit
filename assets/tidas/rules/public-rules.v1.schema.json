{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiangong.earth/tidas/public-rules.v1.schema.json",
  "title": "TIDAS public rule index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "rules_version", "rules"],
  "properties": {
    "$schema": { "const": "public-rules.v1.schema.json" },
    "schema_version": { "const": 1 },
    "rules_version": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}$" },
    "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/rule" } }
  },
  "definitions": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dataset_type", "normative_level", "statement", "locations", "applicability", "source_refs", "cases"],
      "properties": {
        "id": { "type": "string", "pattern": "^tidas\\.(process|flow)\\.[a-z0-9.-]+$" },
        "dataset_type": { "enum": ["process", "flow"] },
        "normative_level": { "enum": ["requirement", "recommendation"] },
        "statement": { "type": "string", "minLength": 1 },
        "locations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope"],
          "properties": { "scope": { "type": "string", "minLength": 1 } }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asset", "path"],
            "properties": {
              "asset": { "enum": ["tidas_processes.yaml", "tidas_flows.yaml"] },
              "path": { "type": "string", "pattern": "^[A-Za-z0-9:<_>.]+\\.<rules>$" }
            }
          }
        },
        "cases": {
          "type": "object",
          "additionalProperties": false,
          "required": ["positive", "negative"],
          "properties": {
            "positive": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "negative": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
